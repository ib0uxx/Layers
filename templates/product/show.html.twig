{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <a href="{{ path('app_products') }}" class="btn btn-outline-secondary mb-3">{{ 'product.back'|trans }}</a>

    <div class="row">
        <div class="col-md-6 text-center">
            {% if product.images|length > 0 %}
                {% set firstImage = product.images|first %}
                <img src="{{ asset(firstImage.url) }}" alt="{{ product.name }}" class="img-fluid rounded shadow">
            {% else %}
                <img src="https://via.placeholder.com/600x400?text=No+Image" alt="{{ 'product.no_image_alt'|trans }}" class="img-fluid rounded shadow">
            {% endif %}
        </div>

        <div class="col-md-6">
            <h1>{{ product.name }}</h1>
            <p class="text-muted">{{ product.description }}</p>
            <h3 class="fw-bold">{{ product.price }} €</h3>

            {% if product.stock > 0 %}
                <p><span class="badge bg-success">{{ 'product.in_stock'|trans }}</span></p>
                <a href="{{ path('app_cart_add', {id: product.id}) }}" class="btn btn-primary mt-3">{{ 'product.add_to_cart'|trans }}</a>
            {% else %}
                <p><span class="badge bg-danger">{{ 'product.out_of_stock'|trans }}</span></p>
                <button class="btn btn-secondary btn-lg mt-3" disabled>{{ 'product.unavailable'|trans }}</button>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
