{% extends 'base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center mb-4">🧢 Nos produits streetwear</h1>

    <div class="row">
        {% for product in products %}
            <div class="col-md-4 mb-4">
                <a href="{{ path('app_product_show', {id: product.id}) }}" class="text-decoration-none text-dark">
    <div class="card shadow-sm h-100">
        {% set firstImage = product.images|first %}
        {% if firstImage %}
            <img src="{{ firstImage.url }}" class="card-img-top" alt="{{ product.name }}">
        {% else %}
            <img src="https://via.placeholder.com/400x300?text=No+Image" class="card-img-top" alt="Pas d'image">
        {% endif %}
        <div class="card-body text-center">
            <h5 class="card-title">{{ product.name }}</h5>
            <p class="card-text text-muted">{{ product.description }}</p>
            <p class="fw-bold">{{ product.price }} €</p>
            {% if product.stock > 0 %}
                <span class="badge bg-success">En stock</span>
            {% else %}
                <span class="badge bg-danger">Rupture</span>
            {% endif %}
        </div>
    </div>
</a>

            </div>
        {% else %}
            <p class="text-center">Aucun produit trouvé.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
