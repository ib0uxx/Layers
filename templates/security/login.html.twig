{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block body %}
<div class="container mt-5" style="max-width: 400px;">
    <h1 class="mb-4 text-center">{{ 'login.heading'|trans }}</h1>

    {% if error %}
        <div class="alert alert-danger">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form method="post">
        <div class="mb-3">
            <label for="inputEmail" class="form-label">{{ 'login.email'|trans }}</label>
            <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
        </div>

        <div class="mb-3">
            <label for="inputPassword" class="form-label">{{ 'login.password'|trans }}</label>
            <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" required>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="btn btn-dark w-100" type="submit">
            {{ 'login.submit'|trans }}
        </button>
    </form>
</div>
{% endblock %}
