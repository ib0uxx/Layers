{% extends 'base.html.twig' %}

{% block title %}Gestion des Catégories{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>🏷️ Catégories</h1>
        <a href="{{ path('app_admin_categories_new') }}" class="btn btn-primary">+ Nouvelle catégorie</a>
    </div>

    {% if categories|length > 0 %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Nom</th>
                        <th>Produits</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                        <tr>
                            <td><strong>{{ category.name }}</strong></td>
                            <td>{{ category.products|length }}</td>
                            <td>
                                <a href="{{ path('app_admin_categories_edit', {id: category.id}) }}" class="btn btn-sm btn-warning">✏️ Éditer</a>
                                <form method="POST" action="{{ path('app_admin_categories_delete', {id: category.id}) }}" style="display:inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                    <button class="btn btn-sm btn-danger" onclick="return confirm('Êtes-vous sûr ?')">🗑️ Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-info">Aucune catégorie trouvée.</div>
    {% endif %}
</div>
{% endblock %}