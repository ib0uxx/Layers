{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center mb-5">🛠️ Tableau de bord administrateur</h1>

    <!-- Statistiques -->
    <div class="row mb-5">
        <div class="col-md-3 mb-4">
            <div class="card text-center shadow-sm bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Produits</h5>
                    <p class="card-text display-4">{{ totalProducts }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-center shadow-sm bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Catégories</h5>
                    <p class="card-text display-4">{{ totalCategories }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-center shadow-sm bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">Utilisateurs</h5>
                    <p class="card-text display-4">{{ totalUsers }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-center shadow-sm bg-warning text-white">
                <div class="card-body">
                    <h5 class="card-title">Commandes</h5>
                    <p class="card-text display-4">{{ totalOrders }}</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <div class="row mb-5">
        <div class="col-md-3 mb-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">📦 Produits</h5>
                    <p class="card-text">Gérer le catalogue</p>
                    <a href="{{ path('app_admin_products_index') }}" class="btn btn-dark">Voir</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">🏷️ Catégories</h5>
                    <p class="card-text">Gérer les catégories</p>
                    <a href="{{ path('app_admin_categories_index') }}" class="btn btn-dark">Voir</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">👥 Utilisateurs</h5>
                    <p class="card-text">Gérer les comptes</p>
                    <a href="{{ path('app_admin_users_index') }}" class="btn btn-dark">Voir</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">📋 Commandes</h5>
                    <p class="card-text">Suivi des ventes</p>
                    <a href="{{ path('app_admin_orders_index') }}" class="btn btn-dark">Voir</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Derniers produits -->
    <div class="row">
        <div class="col-md-6">
            <h3>Derniers produits</h3>
            <div class="list-group">
                {% for product in recentProducts %}
                    <a href="{{ path('app_admin_products_edit', {id: product.id}) }}" class="list-group-item list-group-item-action">
                        <h6>{{ product.name }}</h6>
                        <small>{{ product.price }} €</small>
                    </a>
                {% endfor %}
            </div>
        </div>

        <div class="col-md-6">
            <h3>Dernières commandes</h3>
            <div class="list-group">
                {% for order in recentOrders %}
                    <a href="{{ path('app_admin_orders_show', {id: order.id}) }}" class="list-group-item list-group-item-action">
                        <h6>Commande #{{ order.id }}</h6>
                        <small>{{ order.user.email }} - {{ order.createdAt|date('d/m/Y') }}</small>
                    </a>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}