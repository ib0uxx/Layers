{% extends 'base.html.twig' %}

{% block title %}Profil{% endblock %}

{% block body %}
<div class="container mt-5" style="max-width: 600px;">
    <h1 class="mb-4 text-center">👤 Mon profil</h1>

    <div class="card shadow-sm p-4">
        <p><strong>Nom d'utilisateur :</strong> {{ user.username ?? user.email }}</p>
        <p><strong>Email :</strong> {{ user.email }}</p>

        {% if is_granted('ROLE_ADMIN') %}
            <p><span class="badge bg-danger">Administrateur</span></p>
        {% else %}
            <p><span class="badge bg-secondary">Utilisateur</span></p>
        {% endif %}

        <a href="{{ path('app_logout') }}" class="btn btn-outline-danger mt-3 w-100">Se déconnecter</a>
    </div>
</div>
{% endblock %}
