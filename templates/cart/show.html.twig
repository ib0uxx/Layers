{% extends 'base.html.twig' %}

{% block title %}Votre panier{% endblock %}

{% block body %}
<div class="container mt-5">

    <h1 class="text-center mb-4">🛒 Votre panier</h1>

    {% if cart is empty %}
        <p class="text-center">Votre panier est vide.</p>
    {% else %}

        <table class="table table-striped text-center">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th>Qté</th>
                    <th>Prix</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                {% for item in cart %}
                    <tr>
                        <td>{{ item.product.name }}</td>

                        <td>
                            <a href="{{ path('app_cart_decrease', {id: item.product.id}) }}" class="btn btn-sm btn-warning">-</a>
                            <strong>{{ item.quantity }}</strong>
                            <a href="{{ path('app_cart_add', {id: item.product.id}) }}" class="btn btn-sm btn-success">+</a>
                        </td>

                        <td>{{ item.product.price }} €</td>
                        <td>{{ item.total }} €</td>

                        <td>
                            <a href="{{ path('app_cart_remove', {id: item.product.id}) }}" class="btn btn-sm btn-danger">Supprimer</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <h3 class="text-end mt-4">Total : <strong>{{ total }} €</strong></h3>

            <div class="text-end mt-3">
                <a href="{{ path('app_cart_payment') }}" class="btn btn-success">Passer à la caisse</a>

        <div class="text-end mt-3">
            <a href="{{ path('app_cart_clear') }}" class="btn btn-danger">Vider le panier</a>
        </div>

    {% endif %}
</div>
{% endblock %}
