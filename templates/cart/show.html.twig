{% extends 'base.html.twig' %}

{% block title %}{{ 'cart.title'|trans }}{% endblock %}

{% block body %}
<div class="container mt-5">

    <h1 class="text-center mb-4">{{ 'cart.heading'|trans|raw }}</h1>

    {% if cart is empty %}
        <p class="text-center">{{ 'cart.empty'|trans }}</p>
    {% else %}

        <table class="table table-striped text-center">
            <thead>
                <tr>
                    <th>{{ 'cart.column.product'|trans }}</th>
                    <th>{{ 'cart.column.qty'|trans }}</th>
                    <th>{{ 'cart.column.price'|trans }}</th>
                    <th>{{ 'cart.column.total'|trans }}</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                {% for item in cart %}
                    <tr>
                        <td>{{ item.product.name }}</td>

                        <td>
                            <a href="{{ path('app_cart_decrease', {id: item.product.id}) }}" class="btn btn-sm btn-warning">-</a>
                            <strong>{{ item.quantity }}</strong>
                            <a href="{{ path('app_cart_add', {id: item.product.id}) }}" class="btn btn-sm btn-success">+</a>
                        </td>

                        <td>{{ item.product.price }} €</td>
                        <td>{{ item.total }} €</td>

                        <td>
                            <a href="{{ path('app_cart_remove', {id: item.product.id}) }}" class="btn btn-sm btn-danger">{{ 'cart.remove'|trans }}</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <h3 class="text-end mt-4">{{ 'cart.total_label'|trans }} <strong>{{ total }} €</strong></h3>

            <div class="text-end mt-3">
                <a href="{{ path('app_cart_payment') }}" class="btn btn-success">{{ 'cart.checkout'|trans }}</a>

        <div class="text-end mt-3">
            <a href="{{ path('app_cart_clear') }}" class="btn btn-danger">{{ 'cart.clear'|trans }}</a>
        </div>

    {% endif %}
</div>
{% endblock %}
