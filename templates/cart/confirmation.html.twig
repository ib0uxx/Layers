{% extends 'base.html.twig' %}

{% block title %}Commande confirmée{% endblock %}

{% block body %}
<div class="container mt-5 text-center">

    <h1>🎉 Merci pour votre commande, {{ fullname }} !</h1>

    <p class="mt-4">Votre paiement par <strong>{{ payment }}</strong> a été accepté.</p>

    <h3 class="mt-4">Montant total : <strong>{{ total }} €</strong></h3>

    <a href="{{ path('app_home') }}" class="btn btn-primary mt-4">
        Retour à l'accueil
    </a>

</div>
{% endblock %}
