{% extends 'base.html.twig' %}

{% block title %}{{ 'payment.title'|trans }}{% endblock %}

{% block body %}
<div class="container mt-5">

    <h1 class="text-center mb-4">{{ 'payment.heading'|trans|raw }}</h1>

    <div class="row">
        <div class="col-md-7">

            <h4>{{ 'payment.summary'|trans|raw }}</h4>
            <table class="table table-bordered mt-3">
                <thead>
                    <tr>
                        <th>{{ 'cart.column.product'|trans }}</th>
                        <th>{{ 'cart.column.qty'|trans }}</th>
                        <th>{{ 'cart.column.price'|trans }}</th>
                        <th>{{ 'cart.column.total'|trans }}</th>
                    </tr>
                </thead>

                <tbody>
                    {% for item in cart %}
                        <tr>
                            <td>{{ item.product.name }}</td>
                            <td>{{ item.quantity }}</td>
                            <td>{{ item.product.price }} €</td>
                            <td>{{ item.total }} €</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <h3 class="text-end mt-4">{{ 'cart.total_label'|trans }} <strong>{{ total }} €</strong></h3>

        </div>

        <div class="col-md-5">
            <h4>{{ 'payment.shipping_info'|trans|raw }}</h4>

            <form action="{{ path('app_cart_payment_confirm') }}" method="post" class="mt-3">

                <div class="mb-3">
                    <label for="fullname" class="form-label">{{ 'payment.fullname'|trans }}</label>
                    <input type="text" class="form-control" id="fullname" name="fullname" required>
                </div>

                <div class="mb-3">
                    <label for="address" class="form-label">{{ 'payment.address'|trans }}</label>
                    <input type="text" class="form-control" id="address" name="address" required>
                </div>

                <div class="mb-3">
                    <label for="city" class="form-label">{{ 'payment.city'|trans }}</label>
                    <input type="text" class="form-control" id="city" name="city" required>
                </div>

                <div class="mb-3">
                    <label for="zip" class="form-label">{{ 'payment.zip'|trans }}</label>
                    <input type="text" class="form-control" id="zip" name="zip" required>
                </div>

                <div class="mb-3">
                    <label for="payment" class="form-label">{{ 'payment.method'|trans }}</label>
                    <select id="payment" name="payment" class="form-select" required>
                        <option value="card">{{ 'payment.option.card'|trans }}</option>
                        <option value="paypal">{{ 'payment.option.paypal'|trans }}</option>
                        <option value="bank">{{ 'payment.option.bank'|trans }}</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-success w-100 mt-3">
                    {{ 'payment.confirm'|trans }}
                </button>

            </form>
        </div>
    </div>

</div>
{% endblock %}
